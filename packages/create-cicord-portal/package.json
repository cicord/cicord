  "description": "Reference Cicord community portal (React + Vite+), meant to be forked: `pnpm create cicord-portal my-portal`.",
  "license": "Apache-2.0",
  "bin": {
    "create-cicord-portal": "./bin/create-cicord-portal.mjs"
  },
  "files": [
