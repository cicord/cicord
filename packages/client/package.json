{
  "name": "@codi/client",
  "version": "0.1.0",
  "description": "Typed, framework-agnostic client for the CODI runtime HTTP API v1.",
  "keywords": [
    "api-client",
    "codi",
    "community-portal",
    "discord",
    "gitops"
  ],
  "homepage": "https://github.com/npjonath/codi/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/npjonath/codi/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npjonath/codi.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
