{
  "name": "@cicord/ui",
  "version": "0.1.8",
  "description": "Styled React components for Cicord community portals, driven by the server theme.",
  "keywords": [
    "cicord",
    "community-portal",
    "components",
    "discord",
    "react",
    "ui"
  ],
  "homepage": "https://github.com/cicord/cicord/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/cicord/cicord/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cicord/cicord.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.3.0"
  }
}
