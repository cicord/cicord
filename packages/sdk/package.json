{
  "name": "@cicord/sdk",
  "version": "0.2.2",
  "description": "Cicord plugin SDK: authoring types (spec/sdk/cicord-sdk.d.ts) and a tiny runtime for unit tests in Node.",
  "keywords": [
    "cicord",
    "discord",
    "discord-bot",
    "gitops",
    "plugin",
    "sdk"
  ],
  "homepage": "https://github.com/cicord/cicord/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/cicord/cicord/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cicord/cicord.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.build.json && node scripts/copy-spec-types.mjs",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
