---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import shotOverview from "../assets/screenshots/admin-overview.webp";
import shotPlan from "../assets/screenshots/admin-plan.webp";
import shotSettings from "../assets/screenshots/admin-plugin-settings.webp";
import shotPortal from "../assets/screenshots/portal-custom.webp";
import shotQueue from "../assets/screenshots/portal-custom-queue.webp";
import shotAnalytics from "../assets/screenshots/admin-analytics.webp";
import { links, url } from "../lib/links";
import { ts, yaml, yamlLine } from "../lib/highlight";

const title = "Cicord: GitOps for Discord";
const description =
  "Declare Discord servers and bots in a git repository. Cicord plans every change, applies it, heals drift and runs sandboxed TypeScript plugins. Self-hosted, single binary, pre-release.";

// Hero: a pull request on the Cicord community's own configuration (cicord/cicord-community,
// servers/cicord.yaml) and the plan Cicord computes for it: the stdout of
// `cicord plan --remote` against that configuration running on `cicord dev --sim`.
const diff: [mark: " " | "+" | "-", text: string][] = [
  [" ", "spec:"],
  [" ", "  roles:"],
  ["+", "    helper:"],
  ["+", "      name: Helper"],
  ["+", '      color: "#3ba55d"'],
  ["+", "      mentionable: true"],
  [" ", "    contributor:"],
  [" ", "      name: Contributor"],
  [" ", "  channels:"],
  ["+", "    office-hours:"],
  ["+", "      name: Office hours"],
  ["+", "      type: voice"],
  ["+", "      category: voice"],
];

type PlanLine = { kind: "cmd" | "head" | "add" | "upd" | "field" | "blank" | "sum"; text: string };
const plan: PlanLine[] = [
  { kind: "cmd", text: "cicord plan --remote" },
  { kind: "head", text: "Server cicord: 2 change(s)" },
  { kind: "add", text: '  + create role "Helper"' },
  { kind: "field", text: '      color:       "#3ba55d"' },
  { kind: "field", text: "      mentionable: true" },
  { kind: "field", text: '      name:        "Helper"' },
  { kind: "add", text: '  + create voice channel #Office hours in "Voice"' },
  { kind: "field", text: '      category: "voice"' },
  { kind: "field", text: '      name:     "Office hours"' },
  { kind: "field", text: '      type:     "voice"' },
  { kind: "blank", text: "" },
  { kind: "sum", text: "Plan: 2 to create, 0 to update, 0 to delete." },
];

// The product tour: screenshots of the Cicord community's configuration running on
// `cicord dev --sim` (scripts/screenshots.mjs, set "community"), except Analytics, which needs
// months of history: the admin console's demo data (set "demo").
const tour = [
  {
    id: "overview",
    tab: "Overview",
    path: "/admin/servers/cicord",
    image: shotOverview,
    alt: "The admin console's overview of the Cicord server: Synced and Healthy, its boost level and Community state, the last syncs and the bot's seven plugins.",
    caption: "Sync and health of each server, what is live on Discord, recent syncs and the plugins of every bot.",
  },
  {
    id: "plan",
    tab: "Plan",
    path: "/admin/servers/cicord/plan",
    image: shotPlan,
    alt: "The Plan page: nothing to change, a banner waiting for boost level 2, and a note about a role holder who has not joined yet.",
    caption: "What the next sync would change, and why anything waits: here a banner that needs boost level 2.",
  },
  {
    id: "settings",
    tab: "Plugin settings",
    path: "/admin/servers/cicord/plugins/cicord/tickets",
    image: shotSettings,
    alt: "The settings form of the tickets plugin, with a channel picker, a category picker and staff role pickers.",
    caption: "Forms generated from each plugin's config schema. Saving writes the bot's YAML in git.",
  },
  {
    id: "analytics",
    tab: "Analytics",
    path: "/admin/servers/pixel-haven/analytics",
    image: shotAnalytics,
    alt: "The Analytics page of a demo community: members, joins and leaves, messages, voice time, reactions, commands and moderation actions over 30 days, with charts.",
    caption: "Hourly activity counts, bots apart, with no message content: shown here on the admin console's demo community.",
  },
  {
    id: "portal",
    tab: "Community portal",
    path: "community.cicord.dev",
    image: shotPortal,
    alt: "The Cicord community portal home page, with the server banner, links and the member's shortcuts.",
    caption: "A custom portal built on the SDK: the members' side of the same server.",
  },
  {
    id: "queue",
    tab: "Support queue",
    path: "community.cicord.dev/support",
    image: shotQueue,
    alt: "The staff support queue of the portal: two open tickets with their author, last activity and assignee.",
    caption: "Staff answer tickets from the portal, through the tickets plugin's typed routes.",
  },
];

const serverKeys: [key: string, note: string][] = [
  ["profile", "name, icon, banner, verification"],
  ["community", "rules and updates channels"],
  ["everyone", "@everyone permissions"],
  ["roles", "colors, icons, permissions, members"],
  ["hierarchy", "role order"],
  ["categories", "with permission overwrites"],
  ["channels", "text, voice, forum, stage…"],
  ["welcomeScreen", ""],
  ["onboarding", "prompts and default channels"],
  ["automod", "AutoMod rules"],
  ["emojis", ""],
  ["stickers", ""],
  ["soundboard", ""],
  ["widget", ""],
  ["afk", ""],
  ["access", "admins and moderators"],
  ["portal", "the community portal"],
  ["analytics", "activity counts, portal stats"],
  ["syncPolicy", "selfHeal, prune, deletionProtection"],
];
const width = Math.max(...serverKeys.map(([k]) => k.length)) + 1;
const serverTree = [
  "spec:",
  ...serverKeys.map(([k, note]) => `  ${(k + ":").padEnd(width)}${note ? `  # ${note}` : ""}`),
].join("\n");

// A shorter welcome plugin than examples/basic (no DM, no message template); this source and
// pluginManifest build together with `cicord plugin build`.
const pluginSource = `import { definePlugin } from "@cicord/sdk";

export default definePlugin({
  events: {
    async memberJoin(ctx, member) {
      const { channel, autoRole } = ctx.config;
      await ctx.server.channel(channel).send(\`Welcome \${member.mention}!\`);

      if (autoRole && !member.hasRole(autoRole)) {
        await member.addRole(autoRole, "welcome: default role");
      }

      const total = await ctx.kv.increment("stats:joined");
      ctx.log.info("member welcomed", { member: member.id, total });
    },
  },
});`;

const pluginManifest = `spec:
  entry: ./src/index.ts
  capabilities:
    - discord.messages.send
    - discord.channels.read
    - discord.members.read
    - discord.roles.assign
    - storage.kv
  intents: [ServerMembers]`;

const writeBack = `spec:
  writeBack:
    defaultMode: pullRequest
    policies:
      - paths: ["bots/**"]
        mode: commit
      - paths: ["servers/**"]
        mode: pullRequest`;

const levelsCaps = [
  "discord.messages.send",
  "discord.reactions.manage",
  "discord.channels.read",
  "discord.members.read",
  "discord.roles.assign",
  "storage.kv",
  "scheduler",
  "events.subscribe",
  "portal.routes",
  "portal.links",
];

// Bundled in the binary (examples.Official); the registry also has officialRegistryOnly.
const official = [
  "welcome",
  "onboarding",
  "tickets",
  "polls",
  "levels",
  "moderation",
  "reaction-roles",
  "audit-log",
  "announcements",
];
const officialRegistryOnly = ["github-releases"];
---

<Base title={title} description={description}>
  <section class="hero" aria-labeledby="hero-title">
    <div class="wrap">
      <div class="hero__top">
        <h1 id="hero-title" class="hero__title">
          GitOps for Discord<span class="hero__dot" aria-hidden="true"></span>
        </h1>
        <div class="hero__lede">
          <p class="hero__sub">
            Declare your Discord servers and bots in a git repository. Cicord shows the plan for every
            change, applies it, keeps the server in line with the repository, and runs your bots with
            sandboxed TypeScript plugins.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={links.install}>Get started</a>
            <a class="btn btn--ghost" href={links.github}>
              <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                ></path>
              </svg>
              View on GitHub
            </a>
            <a class="btn btn--ghost" href={links.discord}>
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
                ></path>
              </svg>
              Join the Discord
            </a>
          </div>
          <p class="hero__status">
            <span class="pill">Pre-release</span>
            <span>Cicord 0.1.7, API <code>v1alpha1</code>. Formats and APIs may still change.</span>
          </p>
        </div>
      </div>

      <figure class="flow">
        <div class="pane pane--diff">
          <div class="pane__bar">
            <span class="pane__name">servers/cicord.yaml</span>
            <span class="pane__meta"><span class="t-add">+8</span> <span class="t-del">-0</span></span>
          </div>
          <pre
            class="pane__body"
            aria-label="Diff of servers/cicord.yaml: a new role Helper and a new voice channel Office hours in the Voice category"><code>{diff.map(([mark, text], i) => (
            <span class:list={["dl", { "dl--add": mark === "+" }]} style={`--i:${i}`}><span class="dl__mark" aria-hidden="true">{mark}</span><Fragment set:html={yamlLine(text)} /></span>
          ))}</code></pre>
        </div>

        <div class="flow__link" aria-hidden="true">
          <span class="flow__label">git push</span>
          <svg class="flow__arrow" viewBox="0 0 48 12" focusable="false">
            <path d="M0 6h44M38 1l6 5-6 5" fill="none" stroke="currentColor" stroke-width="1.5"
            ></path>
          </svg>
        </div>

        <div class="pane pane--term">
          <div class="pane__bar">
            <span class="pane__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="pane__name">terminal</span>
          </div>
          <pre class="pane__body term" aria-label="Output of cicord plan"><code>{plan.map((l, i) => (
            <span class={`tl tl--${l.kind}`} style={`--i:${i}`}>{l.kind === "cmd" ? <><span class="tl__prompt" aria-hidden="true">$ </span>{l.text}</> : l.text || " "}</span>
          ))}<span class="tl tl--cursor" style={`--i:${plan.length}`} aria-hidden="true"><span class="tl__prompt">$ </span><span class="cursor"></span></span></code></pre>
        </div>

        <figcaption class="flow__caption">
          A pull request on the
          <a href={links.communityConfig}>Cicord community's configuration</a>{" "}and the plan
          Cicord computes for it. The runtime applies that plan when the change is
          merged into the branch it follows.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section tour" aria-labeledby="tour-title">
    <div class="wrap">
      <div class="tour__head">
        <h2 id="tour-title" class="section__title">See it run a real server</h2>
        <p class="tour__lede">
          The Cicord community's own configuration, running on Cicord: the admin console for the
          team, the portal for the members.
        </p>
      </div>
      <div class="tour__tabs" role="tablist" aria-label="Product screenshots">
        {tour.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tour-tab-${t.id}`}
            aria-controls={`tour-panel-${t.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >{t.tab}</button>
        ))}
      </div>
      {tour.map((t, i) => (
        <figure
          class="window"
          role="tabpanel"
          id={`tour-panel-${t.id}`}
          aria-labelledby={`tour-tab-${t.id}`}
          hidden={i !== 0}
        >
          <div class="window__bar">
            <span class="pane__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="window__path">{t.path}</span>
          </div>
          <Image
            src={t.image}
            alt={t.alt}
            widths={[720, 1440, 2160, 2880]}
            sizes="(min-width: 76rem) 72rem, 100vw"
            loading={i === 0 ? "eager" : "lazy"}
            class="window__shot"
          />
          <figcaption class="window__caption">{t.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section steps-section" aria-labeledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="section__title">From a commit to your server</h2>
      <ol class="steps">
        <li class="step step--ink">
          <span class="step__node" aria-hidden="true"></span>
          <h3>Declare it in git</h3>
          <p>
            Roles, channels, permissions, onboarding and bots live as YAML files in a repository:
            on GitHub, any git host, or a repository Cicord manages for you.
          </p>
          <code class="step__artifact">servers/cicord.yaml</code>
        </li>
        <li class="step step--brand">
          <span class="step__node" aria-hidden="true"></span>
          <h3>Read the plan</h3>
          <p>
            Each revision is compared with the live server. The plan lists every create, update and
            delete before anything is touched, and protected resources are never deleted.
          </p>
          <code class="step__artifact">cicord plan</code>
        </li>
        <li class="step step--brand">
          <span class="step__node" aria-hidden="true"></span>
          <h3>Apply it</h3>
          <p>
            The runtime applies the plan in order (roles, categories, channels, overwrites,
            positions), respecting Discord rate limits, and resumes after a failure.
          </p>
          <code class="step__artifact">cicord serve</code>
        </li>
        <li class="step step--ok">
          <span class="step__node" aria-hidden="true"></span>
          <h3>Stay in sync</h3>
          <p>
            Hand edits to managed roles and channels are detected as they happen: reverted at once
            with <code>selfHeal</code>, otherwise reported until the next revision or Sync now. During
            a raid, pause enforcement and they stay. Edits made in the admin console go to git.
          </p>
          <code class="step__artifact">selfHeal: true</code>
        </li>
      </ol>
    </div>
  </section>

  <section class="section feature" aria-labeledby="f-server">
    <div class="wrap feature__grid">
      <div class="feature__copy">
        <h2 id="f-server" class="section__title">The whole server, as code</h2>
        <p>
          A server file covers what you would otherwise click through in Server Settings: the
          profile, Community, roles, who holds the staff roles, the role order, categories and
          channels with their permission overwrites, the welcome screen, onboarding, AutoMod,
          emojis, stickers and soundboard sounds.
        </p>
        <p>
          Cicord only touches what it manages. Pointing it at an existing server adopts matching
          roles and channels instead of duplicating them, resources you never declared are left
          alone, and a key removed from YAML is deleted, kept or blocked according to your sync
          policy. <code>cicord validate</code> checks the files offline. Before applying, the plan
          checks the permissions of a bot without Administrator, and a change that needs a higher boost level waits, with
          the reason, until the server reaches it.
        </p>
      </div>
      <div class="code-card">
        <div class="code-card__bar"><span>servers/&lt;server&gt;.yaml</span></div>
        <pre class="code-card__body"><code set:html={yaml(serverTree)} /></pre>
      </div>
    </div>
  </section>

  <section class="section feature" aria-labeledby="f-plugins">
    <div class="wrap feature__grid">
      <div class="feature__copy">
        <h2 id="f-plugins" class="section__title">Bots that run your TypeScript, in a sandbox</h2>
        <p>
          One runtime hosts any number of bots across any number of servers. Their behavior comes
          from plugins written in TypeScript with <code>@cicord/sdk</code>: events, slash commands,
          buttons and modals, schedules, storage and portal routes.
        </p>
        <p>
          Each plugin instance runs in its own WebAssembly sandbox with a hard memory cap and a CPU
          budget, and only reaches its own server; a crashed instance restarts without taking the
          others down. A plugin can only do what its manifest declares and the bot grants: an
          ungranted call throws, and a new capability in an update shows up in review. The runtime
          bundles the TypeScript itself, so running Cicord needs no Node.js. Unit tests use
          <code>@cicord/sdk/testing</code>.
        </p>
        <p><a href={links.plugins}>Read the plugin guide</a></p>
      </div>
      <div class="code-stack">
        <div class="code-card">
          <div class="code-card__bar"><span>plugins/welcome/src/index.ts</span><span>simplified</span></div>
          <pre class="code-card__body"><code set:html={ts(pluginSource)} /></pre>
        </div>
        <div class="code-card">
          <div class="code-card__bar"><span>plugins/welcome/plugin.yaml</span><span>excerpt</span></div>
          <pre class="code-card__body"><code set:html={yaml(pluginManifest)} /></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="section feature" aria-labeledby="f-store">
    <div class="wrap feature__grid">
      <div class="feature__copy">
        <h2 id="f-store" class="section__title">A Store where you see what you grant</h2>
        <p>
          The official plugins are published in a signed registry,
          <a href={links.officialPlugins}>cicord-plugins</a>, and most of them ship with the binary
          for offline installs:
          <span class="inline-list"
            >{official.map((p, i) => <><code>{p}</code>{i < official.length - 1 ? ", " : ""}</>)}</span
          >, plus {officialRegistryOnly.map((p, i) => <><code>{p}</code>{i < officialRegistryOnly.length - 1 ? ", " : ""}</>)}{" "}
          from the registry.
        </p>
        <p>
          Third-party plugins come from registries: git repositories with an index. Their trust is
          computed from the URL, never declared, so they are labeled unofficial everywhere and ask
          for an explicit confirmation. Before any install or update, the Store shows the
          capabilities, gateway intents and network hosts being granted, with privileged intents
          highlighted. The reviewed version is pinned in <code>cicord.lock</code> by commit and
          content hash, and an index from the official registry is only trusted when it is signed by
          keys built into the binary.
        </p>
      </div>
      <div class="review" role="img" aria-labeledby="review-cap">
        <div class="review__head">
          <div>
            <p class="review__title">Install Levels</p>
            <p class="review__meta">cicord/levels, version 0.1.0</p>
          </div>
          <span class="tag tag--ok">Official</span>
        </div>
        <div class="review__body">
          <p class="review__label">Capabilities</p>
          <ul class="chips">
            {levelsCaps.map((c) => <li><code>{c}</code></li>)}
          </ul>
          <p class="review__label">Gateway intents</p>
          <ul class="chips">
            <li><code>ServerMessages</code></li>
            <li class="chip--warn"><code>MessageContent</code> privileged</li>
            <li><code>ServerMessageReactions</code></li>
          </ul>
          <p class="review__label">Network hosts</p>
          <p class="review__none">None</p>
        </div>
        <p class="review__foot">
          <span class="tag tag--muted">Unofficial</span>
          <span>A plugin from a third-party registry also asks for an explicit confirmation.</span>
        </p>
        <p id="review-cap" class="visually-hidden">
          Illustration of the Store install review for the official plugin Levels: it lists ten
          capabilities, three gateway intents with MessageContent marked privileged, and no network
          hosts.
        </p>
      </div>
    </div>
  </section>

  <section class="section feature" aria-labeledby="f-admin">
    <div class="wrap feature__grid">
      <div class="feature__copy">
        <h2 id="f-admin" class="section__title">An admin console that writes to git</h2>
        <p>
          Plugin settings are forms generated from each plugin's config schema, with channel and
          role pickers: admins edit everything, moderators the fields a plugin opens to them, and
          nobody opens a YAML file. The console also shows sync status, the plan, drift, the sync
          history, the audit log and server analytics, and refreshes live as the runtime changes.
        </p>
        <p>
          Every save goes back to the repository. Path policies in <code>cicord.yaml</code> decide
          whether a change is committed directly or opened as a pull request for review, so git
          stays the single source of truth.
        </p>
      </div>
      <div class="code-stack">
        <div class="code-card">
          <div class="code-card__bar"><span>cicord.yaml</span><span>excerpt</span></div>
          <pre class="code-card__body"><code set:html={yaml(writeBack)} /></pre>
        </div>
        <ul class="outcomes" aria-label="What the policy above does with two saves">
          <li>
            <span>Change the welcome message</span>
            <code>bots/cicord/bot.yaml</code>
            <span class="tag tag--ok">Commit</span>
          </li>
          <li>
            <span>Add a role</span>
            <code>servers/cicord.yaml</code>
            <span class="tag tag--brand">Pull request</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labeledby="more-title">
    <div class="wrap">
      <h2 id="more-title" class="section__title">Also included</h2>
      <dl class="more">
        <div class="more__item">
          <dt>Setup wizard</dt>
          <dd>
            <p>
              Start <code>cicord serve</code> in an empty directory and follow the one-time link. The
              wizard checks the bot token, intents and role position live, then imports your
              existing server. The first plan has to be empty: everything is adopted, nothing
              changes on Discord.
            </p>
            <p class="more__out"><code>No changes. Discord matches the configuration.</code></p>
          </dd>
        </div>
        <div class="more__item">
          <dt>Inspect before you trust it</dt>
          <dd>
            <p>
              Invite the bot with View Channels only, then run <code>cicord inspect</code> or pick
              Inspect first in the wizard. You get a read-only report: what the bot can see, what it
              could not read, the permissions it would need and why, and the first plan, which must
              be empty before you go further. Cicord makes no write calls to Discord.
            </p>
            <p><a href={url("docs/getting-started/evaluate-a-server/")}>Evaluate an existing server</a></p>
          </dd>
        </div>
        <div class="more__item">
          <dt>An emergency brake, and alerts</dt>
          <dd>
            <p>
              During a raid, a moderator pauses enforcement on the server from the admin console
              or with <code>cicord pause</code>. Nothing is applied until someone resumes and reviews
              the pending plan, and drift stays visible the whole time. Built-in alerts post to a
              Discord or JSON webhook when a plugin fails, a bot drops, a sync breaks or a server is
              paused, and post again when it is resolved. They never include secrets or message content.
            </p>
            <p>
              <a href={url("docs/concepts/reconciliation/#emergency-pause-enforcement")}>Pause enforcement</a> ·
              <a href={url("docs/self-hosting/monitoring/#alerts")}>Alerts</a>
            </p>
          </dd>
        </div>
        <div class="more__item">
          <dt>Discord simulator</dt>
          <dd>
            <p>
              <code>cicord dev --sim</code> replaces Discord with an in-memory server seeded from your
              YAML, with the users alice, bob and charlie. From the console's Simulator panel, join
              servers, send messages, run slash commands and click buttons while plugins hot-reload.
              No token needed.
            </p>
          </dd>
        </div>
        <div class="more__item">
          <dt>Server analytics</dt>
          <dd>
            <p>
              Members, joins and leaves, active members, messages per channel, voice time,
              reactions and how members use every bot of the server, kept as hourly counts in the
              state database. No message content and no member IDs are stored. The portal can
              show the server-wide numbers to the community.
            </p>
            <p><a href={url("docs/self-hosting/analytics/")}>Server analytics</a></p>
          </dd>
        </div>
        <div class="more__item">
          <dt>Community portal SDK</dt>
          <dd>
            <p>
              The runtime serves a community portal at <code>/</code>: sign-in with Discord,
              onboarding, member profile, community stats, themed from YAML. Fork it with
              <code>cicord portal init</code>, or build your own with <code>@cicord/client</code>,
              <code>@cicord/react</code> and <code>@cicord/ui</code> in a site you already have.
            </p>
          </dd>
        </div>
        <div class="more__item">
          <dt>Self-hosted, single binary</dt>
          <dd>
            <p>
              One static Go binary holds the reconciler, the bot gateways, the plugin host, the API,
              the admin console and the portal. No Node.js, no git binary, and no database server
              unless you want PostgreSQL: by default, state is a SQLite file in the data directory.
              Releases ship binaries and a multi-arch container image with signed build provenance,
              and Prometheus metrics are one flag away.
            </p>
            <p><a href={links.deploy}>Self-hosting guide</a></p>
          </dd>
        </div>
        <div class="more__item">
          <dt>Self-host it on one server</dt>
          <dd>
            <p>
              A step-by-step production install on a single VPS: SSH and the admin console
              reachable only from your Tailscale tailnet, Caddy serving the public portal over
              HTTPS, a firewall, a GitHub App with short-lived tokens, and secrets stored encrypted by
              the runtime. An automatic update is kept only when every server, bot and plugin is
              healthy afterwards, and is rolled back otherwise. Daily backups keep the key apart and
              can be copied off the server, and a timed drill restores one onto a fresh machine.
            </p>
            <p><a href={links.productionVps}>Production on a VPS</a></p>
          </dd>
        </div>
        <div class="more__item">
          <dt>A real server, in the open</dt>
          <dd>
            <p>
              The official Cicord community server is managed with Cicord. Its configuration is a
              public repository: roles, channels, permissions, AutoMod, onboarding and the bot's
              plugins, changed through pull requests.
            </p>
            <p>
              <a href={links.communityConfig}>cicord/cicord-community</a> ·
              <a href={links.discord}>Join the server</a>
            </p>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section start" aria-labeledby="start-title">
    <div class="wrap start__grid">
      <div class="start__copy">
        <h2 id="start-title" class="section__title">Get started in five minutes</h2>
        <p>
          Install <code>cicord</code>, then either connect a real server with the setup wizard or
          try everything offline against the simulator. The
          <a href={links.install}>installation guide</a> covers Windows, the container image,
          verifying a download and building from source. Homebrew works too; npm comes with a
          later release.
        </p>
        <aside class="notice" aria-labeledby="status-title">
          <h3 id="status-title">Status: pre-release</h3>
          <p>
            Cicord 0.1.7 implements the API <code>v1alpha1</code>. The runtime, the reconciler, the
            plugin host, the simulator, the admin console and the portal SDK work end to end, and
            run the official community server, but file formats and APIs may still change between
            <code>0.x</code> releases. Expect rough edges, and report them on GitHub.
          </p>
        </aside>
        <p class="start__links">
          <a class="btn btn--primary" href={links.quickStart}>Quick start guide</a>
          <a class="btn btn--ghost" href={links.docs}>Documentation</a>
        </p>
      </div>
      <div class="cmds">
        <div class="cmd">
          <p class="cmd__title">1. Install cicord</p>
          <p class="cmd__note">Linux or macOS. Verifies the checksum, and the provenance with gh.</p>
          <pre><code><span class="p">curl -fsSL https://cicord.dev/install.sh | sh</span>
<span class="t-com"># or: brew install cicord/tap/cicord</span></code></pre>
        </div>
        <div class="cmd">
          <p class="cmd__title">2a. Connect a real server</p>
