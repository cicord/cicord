---
// The Cicord mark (same geometry as packages/admin/public/favicon.svg), drawn with the
// theme tokens so it follows the light and dark themes.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  class="logo"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <rect x=".5" y=".5" width="31" height="31" rx="7.5" class="logo__tile"></rect>
  <circle cx="11" cy="16" r="4" fill="none" class="logo__ink" stroke-width="2.5"></circle>
  <circle cx="23" cy="9" r="3" class="logo__ok"></circle>
  <circle cx="23" cy="23" r="3" class="logo__brand"></circle>
  <path d="M15 15l5-4M15 17l5 4" class="logo__ink" stroke-width="2.5" stroke-linecap="round"
  ></path>
</svg>

<style>
  .logo {
    flex: none;
    display: block;
  }
  .logo__tile {
    fill: var(--tile);
    stroke: var(--line);
  }
  .logo__ink {
    stroke: var(--fg);
  }
  .logo__ok {
    fill: var(--ok-fill);
  }
  .logo__brand {
    fill: var(--brand-fill);
  }
</style>
