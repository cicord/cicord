# Generated by `codi init`.
# CI validates and plans; the runtime (codi serve) applies after merge (GitOps pull model).
#
# Repository settings:
#   secrets.CODI_RUNTIME_TOKEN  the runtime's bearer token (CODI_RUNTIME_TOKEN of codi serve)
#   vars.CODI_RUNTIME_URL       the runtime's https URL. It is set here, never read from
#                               codi.yaml: a pull request must not choose where the token goes.
name: codi
on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: stable
      # Until binary releases exist.
      - run: go install github.com/npjonath/codi/cmd/codi@latest
      - run: codi validate

  plan:
    if: github.event_name == 'pull_request'
    needs: validate
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: stable
      - run: go install github.com/npjonath/codi/cmd/codi@latest
      - run: codi plan --remote --comment
        env:
          CODI_RUNTIME_URL: ${{"{{"}} vars.CODI_RUNTIME_URL }}
          CODI_RUNTIME_TOKEN: ${{"{{"}} secrets.CODI_RUNTIME_TOKEN }}
          GITHUB_TOKEN: ${{"{{"}} github.token }}

  status:
    if: github.event_name == 'push'
    needs: validate
    runs-on: ubuntu-latest
    # A newer merge supersedes the wait for an older one.
    concurrency:
      group: codi-status
      cancel-in-progress: true
    steps:
      - uses: actions/setup-go@v5
        with:
          go-version: stable
      - run: go install github.com/npjonath/codi/cmd/codi@latest
      # The runtime pulls the merged commit (webhook or polling); wait for it to be applied.
      - run: codi status --wait --revision ${{"{{"}} github.sha }} --timeout 10m
        env:
          CODI_RUNTIME_URL: ${{"{{"}} vars.CODI_RUNTIME_URL }}
          CODI_RUNTIME_TOKEN: ${{"{{"}} secrets.CODI_RUNTIME_TOKEN }}
