{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cicord.dev/schemas/v1alpha1/plugin.schema.json",
  "title": "Cicord Plugin manifest",
  "description": "Static, reviewable description of a plugin. File: plugin.yaml at the plugin root. Commands, handlers and routes come from the code (definePlugin).",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Plugin" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/key" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "displayName": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 280 },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "license": {
          "description": "SPDX identifier.",
          "type": "string"
        },
        "homepage": { "type": "string", "format": "uri" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 10
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["engine", "entry"],
      "dependentRequired": { "interop": ["delivery"] },
      "properties": {
        "delivery": {
          "enum": [
            "at-least-once"
          ]
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "when": {"type":"string", "pattern":"^(/([^~/]|~[01])+)+$", "description":"JSON Pointer to an optional boolean instance configuration switch."},
              "feature": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/capability"
                }
              },
              "intents": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/intent"
                }
              }
            },
            "required": [
              "feature"
            ],
            "additionalProperties": false
          }
        },
        "interop": {
          "type": "object",
          "properties": {
            "types": {
              "$ref": "common.schema.json#/$defs/relativePath"
            },
            "publishes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
                  },
                  "scope": {
                    "enum": [
                      "bot",
                      "server"
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "topic"
                ],
                "additionalProperties": false
              }
            },
            "subscribes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+\\.[a-zA-Z][a-zA-Z0-9]*$"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "topic": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+\\.[a-zA-Z][a-zA-Z0-9]*$"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      }
                    },
                    "required": [
                      "topic"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "provides": {
              "type": "object",
              "properties": {
                "queries": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
                  }
                },
                "actions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
                  }
                }
              },
              "additionalProperties": false
            },
            "consumes": {
              "type": "object",
              "properties": {
                "queries": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+\\.[a-zA-Z][a-zA-Z0-9]*$"
                  }
                },
                "actions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+\\.[a-zA-Z][a-zA-Z0-9]*$"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "engine": { "$ref": "common.schema.json#/$defs/semverRange" },
        "locales": { "type": "string", "minLength": 1, "description": "Directory of locale JSON catalogues relative to the plugin." },
        "assets": { "type": "string", "pattern": "^\\./", "description": "Plugin asset directory, at most 5 MiB total." },
        "entry": {
          "description": "TypeScript/JavaScript entry module, default-exporting definePlugin(...).",
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/capability" },
          "uniqueItems": true
        },
        "secrets": {
          "type": "array", "maxItems": 32,
          "items": {"type": "object", "additionalProperties": false, "required": ["name","hosts"],
            "properties": {
              "name": {"$ref":"common.schema.json#/$defs/secretRef"},
              "description": {"type":"string","maxLength":512}, "required":{"type":"boolean"},
              "hosts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/networkHost"}}
            }}
        },
        "privacy": {
          "type": "object",
          "required": ["records"],
          "properties": {
            "records": {
              "type": "array", "maxItems": 256,
              "items": {
                "type": "object",
                "required": ["name", "policy", "description"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 120},
                  "policy": {"enum": ["erase", "anonymize", "retain"]},
                  "description": {"type": "string", "minLength": 1, "maxLength": 1024},
                  "retention": {"type": "string", "minLength": 1, "maxLength": 500},
                  "justification": {"type": "string", "minLength": 1, "maxLength": 1024}
                },
                "if": {"properties": {"policy": {"const": "retain"}}},
                "then": {"required": ["retention", "justification"]},
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "network": {
          "description": "Hosts reachable with http.fetch. Required when http.fetch is requested.",
          "type": "object",
          "properties": {
            "configurable": {"type":"boolean"},
            "allow": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/networkHost" },
              "uniqueItems": true
            }
          },
          "required": ["allow"],
          "additionalProperties": false
        },
        "intents": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/intent" },
          "uniqueItems": true
        },
        "config": {
          "type": "object",
          "required": ["schema"],
          "properties": {
            "schema": {
              "description": "JSON Schema of the plugin config. Supports x-cicord-ref and x-cicord-widget.",
              "$ref": "common.schema.json#/$defs/relativePath"
            }
          },
          "additionalProperties": false
        },
        "routes": {
          "type": "object",
          "properties": {
            "types": {
              "description": "Type-only, self-contained TypeScript file exporting `interface Routes` (the declared query, body and response of each portal route). `cicord portal typegen` copies it into the portals; handlers are checked against it with defineRoutes<Routes>().",
              "$ref": "common.schema.json#/$defs/relativePath"
            }
          },
          "additionalProperties": false
        },
        "client": {
          "description": "Optional npm package with React components for the community portal.",
          "type": "object",
          "required": ["package"],
          "properties": {
            "package": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "capabilities": { "type": "array", "contains": { "const": "http.fetch" } }
        },
        "required": ["capabilities"]
      },
      "then": { "required": ["network"] }
    }
  },
  "additionalProperties": false
}
