{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cicord.dev/schemas/v1alpha1/common.schema.json",
  "title": "Cicord common definitions",
  "$defs": {
    "apiVersion": {
      "const": "cicord.dev/v1alpha1"
    },
    "key": {
      "description": "Stable resource key. Never changes when the display name changes. Used for references and state.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "snowflake": {
      "description": "Discord ID.",
      "type": "string",
      "pattern": "^[0-9]{17,20}$"
    },
    "networkHost": {
      "description": "Public DNS hostname, optional port. A wildcard needs at least two labels after it (*.example.com, not *.com). IP literals, localhost and reserved suffixes are rejected; the runtime re-checks resolved addresses (https://cicord.dev/docs/plugins/writing/).",
      "type": "string",
      "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+([a-z]{2,63}|xn--[a-z0-9-]{1,59})(:[0-9]{1,5})?$",
      "not": {
        "type": "string",
        "pattern": "(^|\\.)(localhost|local|localdomain|internal|intranet|lan|home|corp|arpa|test|invalid|example|onion)(:[0-9]+)?$"
      }
    },
    "secretRef": {
      "description": "Name of a secret resolved by the runtime (environment variable when self-hosted).",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "semverRange": {
      "description": "Semver range, e.g. ^1.2.0, >=0.1.0 <0.2.0.",
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "description": "Path relative to the file that declares it.",
      "type": "string",
      "pattern": "^\\.{1,2}/"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/key" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "permission": {
      "description": "Discord permission, Cicord naming (server instead of guild). See https://cicord.dev/docs/configuration/server/ for the mapping.",
      "enum": [
        "CreateInstantInvite", "KickMembers", "BanMembers", "Administrator", "ManageChannels",
        "ManageServer", "AddReactions", "ViewAuditLog", "PrioritySpeaker", "Stream", "ViewChannel",
        "SendMessages", "SendTTSMessages", "ManageMessages", "EmbedLinks", "AttachFiles",
        "ReadMessageHistory", "MentionEveryone", "UseExternalEmojis", "ViewServerInsights",
        "Connect", "Speak", "MuteMembers", "DeafenMembers", "MoveMembers", "UseVAD",
        "ChangeNickname", "ManageNicknames", "ManageRoles", "ManageWebhooks", "ManageExpressions",
        "UseApplicationCommands", "RequestToSpeak", "ManageEvents", "ManageThreads",
        "CreatePublicThreads", "CreatePrivateThreads", "UseExternalStickers",
        "SendMessagesInThreads", "UseEmbeddedActivities", "ModerateMembers",
        "ViewCreatorMonetizationAnalytics", "UseSoundboard", "CreateExpressions", "CreateEvents",
        "UseExternalSounds", "SendVoiceMessages", "SendPolls", "UseExternalApps", "PinMessages"
      ]
    },
    "permissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/permission" },
      "uniqueItems": true
    },
    "intent": {
      "description": "Gateway intent, Cicord naming. See https://cicord.dev/docs/plugins/writing/#intents for the events that need each one.",
      "enum": [
        "Servers", "ServerMembers", "ServerModeration", "ServerExpressions", "ServerIntegrations",
        "ServerWebhooks", "ServerInvites", "ServerVoiceStates", "ServerPresences", "ServerMessages",
        "ServerMessageReactions", "ServerMessageTyping", "DirectMessages", "DirectMessageReactions",
        "DirectMessageTyping", "MessageContent", "ServerScheduledEvents",
        "AutoModerationConfiguration", "AutoModerationExecution", "ServerMessagePolls",
        "DirectMessagePolls"
      ]
    },
    "capability": {
      "description": "Plugin capability. See https://cicord.dev/docs/plugins/writing/#capabilities-and-grants for what each one allows.",
      "anyOf": [
        { "type": "string", "pattern": "^plugins\\.(query|call):[a-z0-9-]+\\.([a-zA-Z0-9]+|\\*)$" },
        { "enum": [
        "discord.messages.read", "discord.messages.send", "discord.messages.manage", "discord.webhooks.manage",
        "discord.reactions.manage", "discord.members.read", "discord.members.manage",
        "discord.members.moderate", "discord.roles.assign", "discord.channels.read", "discord.auditlog.read", "discord.invites.read", "discord.events.read", "discord.events.manage", "analytics.read",
        "discord.channels.manage", "discord.threads.manage", "discord.voice.move", "discord.dm.send",
        "server.overlays", "server.incident", "server.sync",
        "storage.kv", "render", "media.analyze", "storage.index", "files.read", "scheduler", "http.fetch", "portal.routes", "portal.links",
        "events.publish", "events.subscribe"
        ] }
      ]
    },
    "overwriteTarget": {
      "description": "Permission overwrite target: @everyone, @bot (the managing bot's own managed role), a role key, or member:<discord id>.",
      "type": "string",
      "pattern": "^(@everyone|@bot|[a-z][a-z0-9-]{0,62}|member:[0-9]{17,20})$"
    },
    "overwrites": {
      "description": "Permission overwrites keyed by target.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/overwriteTarget" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "allow": { "$ref": "#/$defs/permissions" },
          "deny": { "$ref": "#/$defs/permissions" }
        },
        "additionalProperties": false
      }
    }
  }
}
