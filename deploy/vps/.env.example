# Copy to .env next to compose.yaml (chmod 600). No secrets here: bot tokens, the Discord
# OAuth secret, the GitHub App key, the webhook secret and the alert webhook URL go into the
# runtime's encrypted store (setup wizard, or `cicord secret set`).

# The runtime image. A release, pinned by its digest (the release notes give it; the line
# below is the form, not a real digest):
#   CICORD_IMAGE=ghcr.io/cicord/cicord:<version>@sha256:<digest>
# or an image built from source on the server: CICORD_IMAGE=cicord:<commit>.
# See https://cicord.dev/docs/self-hosting/production-vps/#the-image
CICORD_IMAGE=ghcr.io/cicord/cicord:<version>@sha256:<digest>

# Automatic updates (scripts/06-auto-update.sh): patch (0.1.x → 0.1.y, the default),
# minor (also 0.x → 0.y: read the release notes first) or off.
CICORD_AUTO_UPDATE=patch
# How an update is verified: attestation (the default: the image's signed build provenance,
# needs a read-only GitHub token in /etc/cicord/github-token) or digest (release notes only).
CICORD_UPDATE_VERIFY=attestation
# How an update is accepted: service (the default: the container's health check and
# `cicord healthcheck --service`: revision loaded, servers Synced and not paused, bots and
# plugins Healthy, before and after the update) or health (the health check only).
CICORD_UPDATE_CHECK=service

# Backups (scripts/05-backup.sh): local retention, and the off-host copy after each backup:
# rclone:<remote>:<path> (configured with `sudo rclone config`) or rsync:[user@]host:<path>
# (over SSH with root's key). Empty: the backups stay on this server only.
# See https://cicord.dev/docs/self-hosting/backups-and-secrets/#off-host-copies
CICORD_BACKUP_KEEP_DAYS=14
CICORD_BACKUP_REMOTE=

# Public community portal (DNS A/AAAA → this server) and the admin console on the tailnet.
CICORD_PUBLIC_URL=https://community.example.org
CICORD_PUBLIC_HOST=community.example.org
CICORD_ADMIN_URL=https://cicord.your-tailnet.ts.net

# Public addresses Caddy binds 80/443 to (not 0.0.0.0: see compose.yaml).
PUBLIC_IPV4=203.0.113.10
PUBLIC_IPV6=2001:db8::10
