{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polls plugin config",
  "type": "object",
  "properties": {
    "defaultHours": {
      "description": "How long a poll stays open when /poll does not say (hours).",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 720,
      "default": 24,
      "x-codi-access": "moderator"
    },
    "maxHours": {
      "description": "Longest poll allowed (hours).",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 720,
      "default": 168,
      "x-codi-access": "moderator"
    },
    "channels": {
      "description": "Channels where /poll may be used. Empty: everywhere.",
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": [],
      "x-codi-ref": "channel",
      "x-codi-access": "moderator"
    },
    "managerRoles": {
      "description": "Roles that may close any poll (its author always can).",
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": [],
      "x-codi-ref": "role"
    },
    "confirmVotes": {
      "description": "Tell voters privately what they voted for.",
      "type": "boolean",
      "default": true
    },
    "color": {
      "description": "Embed color.",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "default": "#5865f2",
      "x-codi-widget": "color"
    }
  },
  "additionalProperties": false
}
